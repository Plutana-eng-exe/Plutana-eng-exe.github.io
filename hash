-- HashLib for Septer-Executor
-- Provides common hashing algorithms as pure Lua
-- Source: https://github.com/Egor-Skriptunoff/pure_lua_SHA (MIT)

local HashLib = {}

local function bxor(a,b)
	local r,m,s=0,2^31
	repeat
		s,a,b=a+b+m,a%m,b%m
		r,m=r+m*s%2,m/2
	until m<1
	return r
end

local function band(a,b)
	local r,m=0,2^31
	repeat
		local s=a+b
		r,a,b=r+m*(2>(s-s%1)%2 and 1 or 0),a%m,b%m
		m=m/2
	until m<1
	return r
end

local function bor(a,b)
	local r,m=0,2^31
	repeat
		local s=a+b
		r,a,b=r+m*((s-s%1)%2>0 and 1 or 0),a%m,b%m
		m=m/2
	until m<1
	return r
end

local function rshift(a,n) return math.floor(a/2^n) end
local function lshift(a,n) return (a*2^n)%(2^32) end
local function rot32(a,n) return bor(lshift(a,n),rshift(a,32-n)) end

-- SHA-256
local function preprocess(data)
	local len=#data
	data=data.."\128"
	while #data%64~=56 do data=data.."\0" end
	local l=len*8
	for i=7,0,-1 do
		data=data..string.char(math.floor(l/256^i)%256)
	end
	return data
end

